---
import { Font } from "astro:assets";
import "../styles/global.css";
import Jellyfish from "@/components/ui/Jellyfish.astro";
import { ClientRouter } from "astro:transitions";


interface Props {
    title: string;
    description?: string;
    image?: string;
    canonicalUrl?: string;
}

const {
    title = "OverTheCluster",
    description = "",
    image = "/og-image.webp",
    canonicalUrl = Astro.url.href,
} = Astro.props;
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{title}</title>
        
        <meta name="description" content={description} />

        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(image, Astro.url)} />
        
        <Font cssVariable="--font-instrument-sans" preload />
        <Font cssVariable="--font-instrument-serif" preload />
        <ClientRouter />
    </head>

    <body>
        <div
          transition:persist
          class="fixed inset-0 z-0 overflow-hidden text-white pointer-events-none"
        >
          <Jellyfish count={5} class="h-full w-full" />
        </div>
        <main class="relative">
            <slot />
        </main>
    </body>
</html>