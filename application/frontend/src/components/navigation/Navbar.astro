---
import { Show, UserButton, SignInButton } from "@clerk/astro/components";
---

<header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between px-6 py-4 backdrop-blur-sm border-b-2 border-[#9234d3]">
  <a
    href="/"
    class="font-mono text-lg font-bold tracking-tight text-white transition-colors hover:text-[#9234d3]"
  >
    0v3r7h3clu573r
  </a>

  <nav class="flex items-center">
    <Show when="signed-out">
      <SignInButton mode="modal" asChild>
        <button
          class="rounded-full border border-[#9234d3]/50 px-4 py-1.5 text-sm text-purple-200 transition-colors hover:bg-[#9234d3]/20 hover:text-white"
        >
          Sign in
        </button>
      </SignInButton>
    </Show>

    <Show when="signed-in">
      <UserButton />
    </Show>
  </nav>
</header>