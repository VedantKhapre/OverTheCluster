---
interface Props {
  href?: string;
  label?: string;
}

const { href = "/ctf", label = "Get started" } = Astro.props;
---

<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-5 pb-16">
  <div class="relative w-full rounded-t-xl border border-b-0 border-[#222222] bg-[#111111] p-1.5 sm:rounded-t-2xl sm:border-2 sm:p-4">
    <span class="absolute left-1/2 top-0.5 size-1 -translate-x-1/2 rounded-full bg-red-500 shadow-[0_0_6px_rgba(239,68,68,0.8)] sm:top-1.5 sm:size-1.5"></span>

    <div class="relative mt-1 flex aspect-video w-full items-center justify-center overflow-hidden rounded-md border border-[#1d1d1d] bg-[#0b0b0b] sm:mt-2 sm:rounded-lg">
      <canvas
        data-matrix-rain
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 h-full w-full opacity-50"
      ></canvas>

      <a
        href={href}
        class="relative z-10 inline-flex items-center rounded-full bg-white/90 px-5 py-2 text-sm font-medium text-black transition hover:bg-blue-500 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 sm:px-6 sm:py-2.5"
      >
        {label}
      </a>
    </div>
  </div>

  <div class="relative h-2 w-[104%] rounded-b-xl border border-[#222222] bg-[#191919] sm:h-3 sm:w-[108%] sm:max-w-[calc(100%+3rem)] sm:rounded-b-2xl sm:border-2">
    <span class="absolute left-1/2 top-0 h-1 w-12 -translate-x-1/2 rounded-b-md border border-t-0 border-[#222222] sm:h-1.5 sm:w-20"></span>
    <span class="absolute left-[8%] top-full h-1.5 w-10 rounded-b-lg bg-[#eeeeee] sm:h-2 sm:w-14"></span>
    <span class="absolute right-[8%] top-full h-1.5 w-10 rounded-b-lg bg-[#eeeeee] sm:h-2 sm:w-14"></span>
  </div>
</section>

<script>
  const CHARS = "01ABCDEFGHIJKLMNOPQRSTUVWXYZ$+-*/=%#&_<>[]{}()|;:?!";
  const FONT_SIZE = 14;
  const BG = "#0b0b0b";
  const FG = "#3b82f6";
  const HEAD = "#bfdbfe";

  let cleanups: Array<() => void> = [];

  function destroy() {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  }

  function setup(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    const parent = canvas.parentElement;
    if (!ctx || !parent) return;

    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let w = 0;
    let h = 0;
    let drops: number[] = [];
    let last = 0;
    let raf = 0;

    const resize = () => {
      const dpr = window.devicePixelRatio || 1;
      w = parent.clientWidth;
      h = parent.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = BG;
      ctx.fillRect(0, 0, w, h);

      // one drop per column, staggered above the top
      const cols = Math.ceil(w / FONT_SIZE);
      drops = Array.from({ length: cols }, () => -Math.random() * (h / FONT_SIZE));
    };

    const draw = (t: number) => {
      raf = requestAnimationFrame(draw);
      if (t - last < 50) return; // ~20fps feels more "terminal"
      last = t;

      // translucent fill leaves the fading trails
      ctx.fillStyle = "rgba(11, 11, 11, 0.12)";
      ctx.fillRect(0, 0, w, h);

      ctx.font = `${FONT_SIZE}px monospace`;

      for (let i = 0; i < drops.length; i++) {
        const y = drops[i] * FONT_SIZE;
        if (y > 0) {
          const ch = CHARS[Math.floor(Math.random() * CHARS.length)];
          ctx.fillStyle = Math.random() > 0.92 ? HEAD : FG;
          ctx.fillText(ch, i * FONT_SIZE, y);
        }
        if (y > h && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    };

    const ro = new ResizeObserver(resize);
    ro.observe(parent);
    resize();
    if (!reduceMotion) raf = requestAnimationFrame(draw);

    cleanups.push(() => {
      cancelAnimationFrame(raf);
      ro.disconnect();
    });
  }

  function init() {
    destroy();
    document
      .querySelectorAll<HTMLCanvasElement>("canvas[data-matrix-rain]")
      .forEach(setup);
  }

  // fires on first load AND after every view-transition navigation
  document.addEventListener("astro:page-load", init);
  // stop the old animation before the DOM is swapped out
  document.addEventListener("astro:before-swap", destroy);
</script>