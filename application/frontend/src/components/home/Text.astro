---
import Button from '@/components/ui/SpecularButton';
import { undefined } from 'astro:schema';
---

<div class="absolute inset-0 flex flex-col items-center justify-center gap-6">
  <h1 class="text-4xl font-bold text-white">
    0v3r7h3clu573r
  </h1>

  <a href="/ctf">
    <Button
        client:load
        size="md"
        radius={40}
        tint="#ffffff"
        tintOpacity={0.04}
        blur={0}
        textColor="#f5f5f5"
        lineColor="#ffffff"
        baseColor="#303030"
        intensity={1.2}
        shineSize={50}
        shineFade={50}
        thickness={1.2}
        glow={1}
        autoAnimate={true}
        speed={0.5}
        followMouse={false}
        style={{}}
        onClick={undefined}
    >
      Get Started
    </Button>
  </a>
</div>