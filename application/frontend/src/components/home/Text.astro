---
import Button from '@/components/ui/SpecularButton';
import Text from "@/components/ui/SplitFlapText";
---

<div class="absolute inset-0 flex flex-col items-center justify-center gap-6">
  <h1 class="text-4xl font-bold text-white">
      <Text
        client:load
        words={["OVER THE CLUSTER"]}
        flipDuration={0.09}
        stagger={0.035}
        cycleDelay={2400}
        charset="alpha"
        flipsPerChar={12}
        order="random"
        align="left"
        tileStyle="board"
        tileColor="#0a0a0a"
        textColor="#facc15"
        glare={0.75}
        depth={0.85}
        tileRadius={3}
        gap={3}
        fontSize={48}
        loop
        padTo={12}
        intro
        style={{}}
      />
  </h1>

  <a href="/ctf">
    <Button
        client:load
        size="md"
        radius={40}
        tint="#ffffff"
        tintOpacity={0.04}
        blur={0}
        textColor="#f5f5f5"
        lineColor="#ffffff"
        baseColor="#303030"
        intensity={1.2}
        shineSize={50}
        shineFade={50}
        thickness={1.2}
        glow={1}
        autoAnimate={true}
        speed={0.5}
        followMouse={false}
        style={{}}
        onClick={undefined}
    >
      Get Started
    </Button>
  </a>
</div>